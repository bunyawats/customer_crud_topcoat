  "query": "\n        SELECT id, first_name, last_name, email, phone, created_at, updated_at\n        FROM customers\n        WHERE $1::text IS NULL\n           OR first_name || ' ' || last_name ILIKE $1\n           OR email ILIKE $1\n           OR phone ILIKE $1\n        ORDER BY last_name, first_name, id\n        LIMIT $2 OFFSET $3\n        ",
