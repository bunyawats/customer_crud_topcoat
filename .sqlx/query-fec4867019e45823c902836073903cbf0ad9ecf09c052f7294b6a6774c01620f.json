  "query": "\n        SELECT oi.id, oi.product_id, p.name AS product_name, oi.quantity, oi.unit_price_cents\n        FROM order_items oi\n        JOIN products p ON p.id = oi.product_id\n        WHERE oi.order_id = $1\n        ORDER BY oi.id\n        ",
